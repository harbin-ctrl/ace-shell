/build/

# Scratch directories a test leaves behind if it is interrupted.
/.ace-filesystem-mapping.*
/.ace-file-commands.*

# tine builds in its own source directory rather than into build/.
/tools/tine/*.o
/tools/tine/tine
*.sock
*.pid
*.log

# Local handoff notes, readmes, and exported-session text are not source.
HANDOFF*.md
README*.md
export*.txt
exports*.txt

# dpkg-buildpackage leaves its staging tree and bookkeeping in debian/.
debian/tmp/
debian/files
debian/.debhelper/
debian/*.substvars
debian/*.debhelper.log
debian/debhelper-build-stamp
debian/ace-shell/
