#!/usr/bin/env bash

sourced=0
[[ ${BASH_SOURCE[0]} != "$0" ]] && sourced=1
if (( ! sourced )); then
    set +e
fi

# Through the link, not to it: PATH holds a symlink into the install, and the
# broker this script starts and stops is the one beside the real file.
script_file=${BASH_SOURCE[0]}
if [[ -L $script_file ]]; then
    script_file=$(readlink -f -- "$script_file")
fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_file")" 2>/dev/null && pwd)
if [[ -x $script_dir/build/ace-broker ]]; then
    ace_runtime_dir=$script_dir/build
else
    ace_runtime_dir=$script_dir
fi
broker_binary=$ace_runtime_dir/ace-broker
mode_args=()
for argument in "$@"; do
    case $argument in
        --root)
            mode_args+=("$argument")
            ;;
        *)
            printf 'usage: %s [--root]\n' \
                "${BASH_SOURCE[0]}" >&2
            if (( sourced )); then return 2; else exit 2; fi
            ;;
    esac
done
# Ask the binary where it would listen rather than reimplementing the rule.
# The name encodes the SYS: root and the protocol version, and a shell copy of
# that would be one more thing to keep in step -- see src/broker_identity.c.
#
# Guarded, because a broker predating the flag takes any argument as the
# socket path: it would bind a socket literally named --print-socket and sit
# there serving it, and the command substitution would never return. The
# timeout bounds that, and the leading-slash test rejects whatever such a
# broker might have printed before it blocked.
broker_print_socket()
{
    local reported
    [[ -x $broker_binary ]] || return 1
    reported=$(timeout 5 "$broker_binary" "${mode_args[@]}" \
        --print-socket 2>/dev/null | head -n 1)
    [[ $reported == /* ]] || return 1
    printf '%s\n' "$reported"
}
broker_socket=${ACE_BROKER_SOCKET:-$(broker_print_socket)}
broker_socket=${broker_socket:-/tmp/ace-broker-$(id -u).sock}
broker_pid_file=${ACE_BROKER_PIDFILE:-${broker_socket}.pid}
experimental_commands=$ace_runtime_dir

add_experimental_commands_to_path()
{
    case ":${PATH-}:" in
        *":$experimental_commands:"*) ;;
        *) PATH="$experimental_commands${PATH:+:$PATH}"; export PATH ;;
    esac
}

start_failed()
{
    printf '%s\n' 'broker start failed'
    if (( sourced )); then
        return 1
    fi
    exit 1
}

# One broker per originating user and mode. If a broker already holds this
# socket's lock, leave it
# alone: restarting it would throw away the current directories, assigns and
# variables of every session it is holding, which is what "start" used to do
# unconditionally on its way past. The lock is the broker's own, so this asks
# the authority rather than guessing from process lists.
broker_lock=$broker_socket.lock
if command -v flock >/dev/null 2>&1 && [[ -e $broker_lock ]] &&
   ! flock -n "$broker_lock" true 2>/dev/null; then
    add_experimental_commands_to_path
    printf '%s\n' 'broker already running'
    if (( sourced )); then return 0; else exit 0; fi
fi

if [[ ! -x $broker_binary ]]; then
    start_failed
    (( sourced )) && return 1
fi

umask 077
nohup "$broker_binary" "${mode_args[@]}" "$broker_socket" \
    >/dev/null 2>&1 </dev/null &
broker_pid=$!

if ! printf '%s\n' "$broker_pid" > "$broker_pid_file" 2>/dev/null; then
    kill -TERM "$broker_pid" 2>/dev/null
    start_failed
    (( sourced )) && return 1
fi

broker_ready=0
for wait_count in {1..100}; do
    if [[ -S $broker_socket ]] && kill -0 "$broker_pid" 2>/dev/null; then
        broker_ready=1
        break
    fi
    sleep 0.02
done

if (( ! broker_ready )); then
    kill -TERM "$broker_pid" 2>/dev/null
    sleep 0.05
    kill -KILL "$broker_pid" 2>/dev/null
    rm -f -- "$broker_pid_file" 2>/dev/null
    start_failed
    (( sourced )) && return 1
fi

add_experimental_commands_to_path
printf '%s\n' 'broker started'
