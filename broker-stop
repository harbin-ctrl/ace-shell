#!/usr/bin/env bash

sourced=0
[[ ${BASH_SOURCE[0]} != "$0" ]] && sourced=1
if (( ! sourced )); then
    set +e
fi

# Through the link, not to it: PATH holds a symlink into the install, and the
# broker this script starts and stops is the one beside the real file.
script_file=${BASH_SOURCE[0]}
if [[ -L $script_file ]]; then
    script_file=$(readlink -f -- "$script_file")
fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_file")" 2>/dev/null && pwd)
if [[ -x $script_dir/build/ace-broker ]]; then
    ace_runtime_dir=$script_dir/build
else
    ace_runtime_dir=$script_dir
fi
broker_binary=$ace_runtime_dir/ace-broker
mode_args=()
root_requested=0
for argument in "$@"; do
    case $argument in
        --root)
            mode_args+=("$argument")
            root_requested=1
            ;;
        *)
            printf 'usage: %s [--root]\n' \
                "${BASH_SOURCE[0]}" >&2
            if (( sourced )); then return 2; else exit 2; fi
            ;;
    esac
done
# Ask the binary where it would listen rather than reimplementing the rule.
# The name encodes the SYS: root and the protocol version, and a shell copy of
# that would be one more thing to keep in step -- see src/broker_identity.c.
#
# Guarded, because a broker predating the flag takes any argument as the
# socket path: it would bind a socket literally named --print-socket and sit
# there serving it, and the command substitution would never return. The
# timeout bounds that, and the leading-slash test rejects whatever such a
# broker might have printed before it blocked.
broker_print_socket()
{
    local reported
    [[ -x $broker_binary ]] || return 1
    reported=$(timeout 5 "$broker_binary" "${mode_args[@]}" \
        --print-socket 2>/dev/null | head -n 1)
    [[ $reported == /* ]] || return 1
    printf '%s\n' "$reported"
}
broker_socket=${ACE_BROKER_SOCKET:-$(broker_print_socket)}
broker_socket=${broker_socket:-/tmp/ace-broker-$(id -u).sock}
broker_pid_file=${ACE_BROKER_PIDFILE:-${broker_socket}.pid}
experimental_commands=$ace_runtime_dir
broker_pids=()

remove_experimental_commands_from_path()
{
    local entry
    local rebuilt_path=
    local old_ifs=$IFS

    IFS=:
    read -r -a path_entries <<< "${PATH-}"
    IFS=$old_ifs
    for entry in "${path_entries[@]}"; do
        [[ $entry == "$experimental_commands" ]] && continue
        if [[ -z $rebuilt_path ]]; then
            rebuilt_path=$entry
        else
            rebuilt_path=$rebuilt_path:$entry
        fi
    done
    PATH=$rebuilt_path
    export PATH
}

is_broker_pid()
{
    local candidate=$1
    local command_line

    [[ $candidate =~ ^[0-9]+$ ]] || return 1
    [[ -r /proc/$candidate/cmdline ]] || return 1
    command_line=$(tr '\0' ' ' < "/proc/$candidate/cmdline" 2>/dev/null) || return 1
    [[ " $command_line " == *" $broker_socket "* ]]
}

signal_broker()
{
    local signal_name=$1
    local candidate=$2

    kill "-$signal_name" "$candidate" 2>/dev/null && return 0
    (( root_requested )) || return 1
    if command -v sudo >/dev/null 2>&1 &&
       sudo -n kill "-$signal_name" "$candidate" 2>/dev/null; then
        return 0
    fi
    if command -v pkexec >/dev/null 2>&1; then
        pkexec kill "-$signal_name" "$candidate" 2>/dev/null
        return $?
    fi
    return 1
}

remember_pid()
{
    local candidate=$1
    local existing

    is_broker_pid "$candidate" || return 0
    for existing in "${broker_pids[@]}"; do
        [[ $existing == "$candidate" ]] && return 0
    done
    broker_pids+=("$candidate")
}

# The broker records its pid in the lock file it holds for its whole life, so
# prefer that over the pid file and over scanning /proc. The lock file is per
# socket, so whoever wrote it is by construction this socket's broker, and it
# is accepted without the command line having to carry the path -- which the
# /proc scan below does still require, because there the socket is the only
# thing keeping it from matching some other user's broker.
broker_lock=$broker_socket.lock
if [[ -r $broker_lock ]]; then
    read -r broker_pid < "$broker_lock" 2>/dev/null
    if [[ $broker_pid =~ ^[0-9]+$ && -r /proc/$broker_pid/cmdline ]] &&
       [[ $(tr "\0" " " < "/proc/$broker_pid/cmdline" 2>/dev/null) == */ace-broker* ]]; then
        broker_pids+=("$broker_pid")
    fi
fi

if [[ -r $broker_pid_file ]]; then
    read -r broker_pid < "$broker_pid_file"
    remember_pid "$broker_pid"
fi

for process_dir in /proc/[0-9]*; do
    [[ -r $process_dir/cmdline ]] || continue
    remember_pid "${process_dir##*/}"
done

broker_was_running=0
for broker_pid in "${broker_pids[@]}"; do
    if signal_broker 0 "$broker_pid"; then
        broker_was_running=1
        signal_broker TERM "$broker_pid"
    fi
done

if (( broker_was_running )); then
    for wait_count in {1..50}; do
        broker_is_alive=0
        for broker_pid in "${broker_pids[@]}"; do
            if signal_broker 0 "$broker_pid"; then
                broker_is_alive=1
                break
            fi
        done
        (( broker_is_alive )) || break
        sleep 0.02
    done

    if (( broker_is_alive )); then
        for broker_pid in "${broker_pids[@]}"; do
            signal_broker KILL "$broker_pid"
        done
    fi
fi

rm -f -- "$broker_pid_file" 2>/dev/null

if (( sourced )); then
    remove_experimental_commands_from_path
fi

if (( broker_was_running )); then
    printf '%s\n' 'broker stopped'
else
    printf '%s\n' 'no broker running'
fi
