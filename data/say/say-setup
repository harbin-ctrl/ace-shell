#!/bin/bash
# Install Piper and ACE's initial voices for the current user.  The normal
# per-user `make install` invokes this helper; it is also safe to run again.
set -euo pipefail
BIN="${XDG_DATA_HOME:-$HOME/.local/share}/say"
VOICES="$BIN/voices"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/say"
VENV="$BIN/venv"
BASE_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main"
die() { printf 'say-setup: %s\n' "$*" >&2; exit 1; }
for tool in python3 curl; do command -v "$tool" >/dev/null || die "missing $tool"; done
python3 -c 'import venv' 2>/dev/null || die 'python3 venv module is missing'
[[ -x "$VENV/bin/python" ]] || { python3 -m venv "$VENV"; "$VENV/bin/pip" install -q --upgrade pip; }
"$VENV/bin/python" -c 'import piper, flask' 2>/dev/null || "$VENV/bin/pip" install -q 'piper-tts[http]'
mkdir -p "$VOICES" "$CONF_DIR"
for spec in 'amy 5002 en/en_US/amy/medium/en_US-amy-medium' 'ryan 5001 en/en_US/ryan/medium/en_US-ryan-medium'; do
    read -r name port path <<<"$spec"; base=$(basename "$path")
    for ext in onnx onnx.json; do
        target="$VOICES/$base.$ext"
        if [[ ! -s "$target" ]]; then
            curl -fL --progress-bar -o "$target.part" "$BASE_URL/$path.$ext"
            mv "$target.part" "$target"
        fi
    done
done
cat >"$CONF_DIR/voices.conf" <<EOF
# say voices: <name> <port> <model>
amy 5002 $VOICES/en_US-amy-medium.onnx
ryan 5001 $VOICES/en_US-ryan-medium.onnx
default-female amy
default-male ryan
EOF
printf 'say-setup: ready. Try: say WARM && say hello there\n'
