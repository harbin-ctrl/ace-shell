#!/usr/bin/make -f

export PREFIX = /usr

%:
	dh $@

override_dh_auto_build:
	$(MAKE) all

override_dh_auto_install:
	$(MAKE) stage-install DESTDIR=$(CURDIR)/debian/tmp

# Regina is compiled by the Makefile's own rules; nothing runs its configure.
# Refreshing its config.guess and config.sub only dirties the vendored tree.
override_dh_update_autotools_config:

# dh_clean deletes *.bak, and Regina tracks one as source.
override_dh_clean:
	dh_clean -Xgci_convert.linux.powerpc64.bak
